---
const baseUrl = import.meta.env.BASE_URL;

const categories = [
  { name: "All", slug: "" },
  { name: "AI & Tech", slug: "ai-tech" },
  { name: "Development", slug: "development" },
  { name: "Entrepreneurship", slug: "entrepreneurship" },
  { name: "Marketing & SEO", slug: "marketing-seo" },
];

interface Props {
  currentCategory?: string;
}

const { currentCategory = "" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full glass-panel border-b border-white/10 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={baseUrl} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-amber-500 flex items-center justify-center text-white font-black shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform duration-200">
        🔥
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-100 to-gray-400">
          Viral<span class="text-brand-500">Loom</span>
        </span>
        <span class="text-[10px] uppercase tracking-widest text-gray-400 font-semibold -mt-1">
          VPH Analytics
        </span>
      </div>
    </a>

    <!-- Navigation categories (Desktop) -->
    <nav class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-full border border-white/5">
      {categories.map((cat) => {
        const isActive = currentCategory === cat.slug;
        const href = cat.slug ? `${baseUrl}categoria/${cat.slug}` : baseUrl;
        return (
          <a
            href={href}
            class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-200 ${
              isActive
                ? "bg-brand-500 text-white shadow-md shadow-brand-500/30"
                : "text-gray-400 hover:text-white hover:bg-white/5"
            }`}
          >
            {cat.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 -ml-3.5"></span>
        <span>Live Feed</span>
      </div>
      <a
        href="https://github.com/PabloAballe/ViralLoom"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors"
      >
        GitHub ↗
      </a>
    </div>
  </div>
</header>
