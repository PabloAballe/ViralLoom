---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { VideoGrid } from '../../components/VideoGrid';
import rawTendencias from '../../../tendencias.json';

export async function getStaticPaths() {
  const tendencias = Array.isArray(rawTendencias) ? rawTendencias : [];
  
  const categoriesMap = new Map();
  tendencias.forEach((v) => {
    if (v.category_slug) {
      categoriesMap.set(v.category_slug, v.category);
    }
  });

  return Array.from(categoriesMap.entries()).map(([slug, name]) => ({
    params: { slug },
    props: { categoryName: name, slug },
  }));
}

const { categoryName, slug } = Astro.props;
const tendencias = Array.isArray(rawTendencias) ? rawTendencias : [];
---

<Layout
  title={`Viral ${categoryName} Videos (VPH) - ViralLoom`}
  description={`Trending viral videos in ${categoryName} sorted by Views Per Hour (VPH). Uncover emerging content in real time.`}
>
  <Header currentCategory={slug} />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    
    <!-- Category Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
        <span>Featured Category</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Viral Videos in <span class="text-brand-500">{categoryName}</span>
      </h1>
      <p class="text-sm text-gray-400 max-w-xl">
        Filtered emerging content in {categoryName} calculated by VPH velocity.
      </p>
    </div>

    <!-- Video Grid filtered by category -->
    <VideoGrid client:load initialVideos={tendencias} categoryFilter={slug} />

  </main>

  <Footer />
</Layout>
